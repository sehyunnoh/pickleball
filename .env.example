# Copy to .env.local and fill in. .env.local is gitignored.

# YouTube Data API v3 key. Used only by the build-time content scripts
# (fetch:videos, and metadata lookup in add:video / check:links). The site
# never calls YouTube at request time, so this is not needed to run the app.
YOUTUBE_API_KEY=

# Analytics needs no key. Vercel Web Analytics is enabled in the Vercel
# dashboard and its script is only served on Vercel deployments, so dev servers
# and local builds stay out of the numbers on their own.
# See components/Analytics.tsx.

# Display ads. Leave unset until AdSense has actually approved the site —
# the slot positions exist in the layout either way, they just render nothing.
# See components/AdSlot.tsx.
NEXT_PUBLIC_ADS_ENABLED=

# Address shown on /about for corrections. The section is hidden when unset.
NEXT_PUBLIC_CONTACT_EMAIL=
